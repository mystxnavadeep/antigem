# ==============================================================================
# antiGem Cloud Workspace - Environment Template
# For GitHub Actions Secrets & Local Testing
# ==============================================================================

# Tailscale Authentication Key (Reusable, pre-authorized, ephemeral recommended)
# Generated from Tailscale Admin Console -> Settings -> Keys
TAILSCALE_AUTH_KEY=tskey-auth-kxxxxxxxxxxxxxxxxxxxxxxx

# Google Drive Service Account or OAuth credentials (Full JSON content as a single line or string)
# Obtained from Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys
GDRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Optional: Specific Google Drive Folder ID to store backups (defaults to 'AntiGem-Cloud-Backups')
# GDRIVE_FOLDER_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backup Encryption Key (Passphrase used with AES-256-CBC PBKDF2 to encrypt backups)
# Choose a strong secret phrase: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=your-super-secret-encryption-passphrase-here

# Optional: Custom Tailscale Tags (if enforced by your Tailscale ACL policy)
# TAILSCALE_TAGS=tag:server

# Port Configuration
SSH_PORT=22
BRIDGE_PORT=1234
HUB_PORT=1235
